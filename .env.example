# Copy this file to .env and fill in your keys. .env is git-ignored; never commit it.

# --- AI script writer (free tier: https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternative: any OpenAI-compatible API (OpenAI, Groq, local Ollama ...)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# What the channel is about; used when topics.txt is empty.
CHANNEL_THEME=short feel-good animated stories with a fun fact or a life lesson

# --- Narration ---
NARRATION_VOICE=piper:en_US-ryan-medium
NARRATION_SPEED=1.05

# --- YouTube ---
YOUTUBE_PRIVACY=public
# 1 = Film & Animation, 27 = Education, 24 = Entertainment
YOUTUBE_CATEGORY_ID=1

# --- Rendering ---
RENDER_CONCURRENCY=1